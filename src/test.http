### Тестирование API мини-приложения
### Базовый URL: http://localhost:8000

### =====================================================
### 1. КОРНЕВЫЕ ЭНДПОИНТЫ
### =====================================================

### Проверка работы API
GET http://localhost:8000/
Content-Type: application/json

### Health check
GET http://localhost:8000/health
Content-Type: application/json

### =====================================================
### 2. КНОПКИ (buttons)
### =====================================================

### Получить все активные кнопки
GET http://localhost:8000/api/buttons
Content-Type: application/json
X-User-Id: 1

### =====================================================
### 3. ФОРМЫ (forms)
### =====================================================

### Получить форму для кнопки ID=1 (Справка об обучении)
GET http://localhost:8000/api/buttons/1/form
Content-Type: application/json
X-User-Id: 1

### Получить форму для кнопки ID=2 (Запись на консультацию)
GET http://localhost:8000/api/buttons/2/form
Content-Type: application/json
X-User-Id: 1

### Получить форму для кнопки ID=3 (Заявка на стипендию)
GET http://localhost:8000/api/buttons/3/form
Content-Type: application/json
X-User-Id: 1

### Попробовать получить форму для несуществующей кнопки (ошибка 404)
GET http://localhost:8000/api/buttons/999/form
Content-Type: application/json
X-User-Id: 1

### =====================================================
### 4. ЗАЯВКИ (submissions)
### =====================================================

### Создать заявку на справку об обучении (кнопка ID=1)
POST http://localhost:8000/api/submissions
Content-Type: application/json
X-User-Id: 1

{
  "button_id": 1,
  "answers": [
    {
      "question_id": 1,
      "value": "Иванов Иван Иванович"
    },
    {
      "question_id": 2,
      "value": "ПИ-31"
    },
    {
      "question_id": 3,
      "value": "+79991234567"
    },
    {
      "question_id": 4,
      "value": "3 курс"
    },
    {
      "question_id": 5,
      "value": "Для получения повышенной стипендии"
    }
  ]
}

### Создать заявку на консультацию (кнопка ID=2)
POST http://localhost:8000/api/submissions
Content-Type: application/json
X-User-Id: 1

{
  "button_id": 2,
  "answers": [
    {
      "question_id": 6,
      "value": "Петров Петр Петрович"
    },
    {
      "question_id": 7,
      "value": "+79876543210"
    },
    {
      "question_id": 8,
      "value": "Диплом"
    },
    {
      "question_id": 9,
      "value": "Когда будет защита диплома?"
    }
  ]
}

### Создать заявку на стипендию (кнопка ID=3)
POST http://localhost:8000/api/submissions
Content-Type: application/json
X-User-Id: 2

{
  "button_id": 3,
  "answers": [
    {
      "question_id": 10,
      "value": "Сидорова Мария Ивановна"
    },
    {
      "question_id": 11,
      "value": "ЭК-42"
    },
    {
      "question_id": 12,
      "value": "sidorova@university.ru"
    },
    {
      "question_id": 13,
      "value": "4.8"
    },
    {
      "question_id": 14,
      "value": "Да"
    }
  ]
}

### Попробовать создать заявку с несуществующим вопросом (ошибка)
POST http://localhost:8000/api/submissions
Content-Type: application/json
X-User-Id: 1

{
  "button_id": 1,
  "answers": [
    {
      "question_id": 999,
      "value": "Тест"
    }
  ]
}

### Создать заявку без обязательных полей (ошибка - но фронт должен валидировать)
POST http://localhost:8000/api/submissions
Content-Type: application/json
X-User-Id: 1

{
  "button_id": 1,
  "answers": []
}

### =====================================================
### 5. МОИ ЗАЯВКИ (my submissions)
### =====================================================

### Получить все заявки пользователя ID=1
GET http://localhost:8000/api/submissions/my
Content-Type: application/json
X-User-Id: 1

### Получить все заявки пользователя ID=2
GET http://localhost:8000/api/submissions/my
Content-Type: application/json
X-User-Id: 2

### Получить заявки пользователя, которого нет в БД
GET http://localhost:8000/api/submissions/my
Content-Type: application/json
X-User-Id: 999

### =====================================================
### 6. ТЕСТИРОВАНИЕ С РАЗНЫМИ USER-ID
### =====================================================

### Создать заявку от пользователя ID=1
POST http://localhost:8000/api/submissions
Content-Type: application/json
X-User-Id: 1

{
  "button_id": 1,
  "answers": [
    {"question_id": 1, "value": "Тестовый Тест Тестович"},
    {"question_id": 2, "value": "ТЕСТ-00"},
    {"question_id": 3, "value": "+79990000000"},
    {"question_id": 4, "value": "1 курс"}
  ]
}

### Создать заявку от пользователя ID=2
POST http://localhost:8000/api/submissions
Content-Type: application/json
X-User-Id: 2

{
  "button_id": 2,
  "answers": [
    {"question_id": 6, "value": "Другой Друг Другович"},
    {"question_id": 7, "value": "+79991111111"},
    {"question_id": 8, "value": "Сессия"},
    {"question_id": 9, "value": "Как подготовиться к экзаменам?"}
  ]
}

### Создать заявку без заголовка X-User-Id (будет использован дефолтный ID=1)
POST http://localhost:8000/api/submissions
Content-Type: application/json

{
  "button_id": 1,
  "answers": [
    {"question_id": 1, "value": "Аноним Анонимов"},
    {"question_id": 2, "value": "АН-00"},
    {"question_id": 3, "value": "+79992222222"},
    {"question_id": 4, "value": "2 курс"}
  ]
}

### =====================================================
### 7. ДОПОЛНИТЕЛЬНЫЕ ТЕСТЫ
### =====================================================

### Создать заявку с очень длинным текстом
POST http://localhost:8000/api/submissions
Content-Type: application/json
X-User-Id: 1

{
  "button_id": 1,
  "answers": [
    {"question_id": 1, "value": "Очень Длинное ФИО Для Проверки Ограничений"},
    {"question_id": 2, "value": "ГРУППА-999"},
    {"question_id": 3, "value": "+79999999999"},
    {"question_id": 5, "value": "Это очень длинный текст цели получения справки. Мне нужна справка для предоставления в несколько мест одновременно. Я планирую использовать её для стипендии, для военкомата и для работы. Пожалуйста, сделайте все копии и поставьте печати. Спасибо большое за понимание!"}
  ]
}

### Создать заявку с выбором варианта "Нет" для общежития
POST http://localhost:8000/api/submissions
Content-Type: application/json
X-User-Id: 2

{
  "button_id": 3,
  "answers": [
    {"question_id": 10, "value": "Иванов Иван Иванович"},
    {"question_id": 11, "value": "ИТ-11"},
    {"question_id": 12, "value": "ivan@mail.ru"},
    {"question_id": 13, "value": "4.2"},
    {"question_id": 14, "value": "Нет"}
  ]
}